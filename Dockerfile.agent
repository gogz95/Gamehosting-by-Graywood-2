# ==============================================================================
# Dockerfile.agent — Lightweight worker node daemon
# Connects to GameHost master via secure WebSocket, manages local Docker
# Usage: docker build -f Dockerfile.agent -t gamehost-agent .
#        docker run -d --restart=unless-stopped \
#          -e MASTER_URL=wss://panel.yourdomain.com \
#          -e ENROLLMENT_TOKEN=gh_node_xxx \
#          -e NODE_NAME=proxmox-node-2 \
#          -v /var/run/docker.sock:/var/run/docker.sock \
#          gamehost-agent
# ==============================================================================

FROM node:20-alpine

WORKDIR /agent

# Runtime tools: docker-cli to talk to local Docker Engine
RUN apk add --no-cache docker-cli curl

# Install only what the agent needs (tsx + ws runtime deps)
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Install tsx globally for running the agent TypeScript directly
RUN npm install -g tsx

# Copy only the agent source file
COPY agent.ts ./

# ─── Environment ────────────────────────────────────────────────────────────
# Required: http:// or ws:// URL of your GameHost master panel
# The agent auto-converts http→ws, so both formats work
ENV MASTER_URL=""
# Required: enrollment token issued from master panel Settings → Nodes
# Must match what agent.ts reads via NODE_TOKEN env var
ENV NODE_TOKEN=""
# Optional: human-readable name shown in the cluster UI
ENV NODE_NAME="proxmox-agent"
# Optional: location label shown in cluster UI
ENV NODE_LOCATION="Proxmox Cluster"
# Optional: public IP of this node (auto-detected if blank)
ENV NODE_IP=""
ENV NODE_ENV=production

# ─── Health Check ───────────────────────────────────────────────────────────
# Agent exposes nothing externally — health check verifies Docker socket access
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD docker info > /dev/null 2>&1 || exit 1

# ─── Entrypoint ─────────────────────────────────────────────────────────────
CMD ["tsx", "agent.ts"]
