{
  "name": "gamehost-deployer-proxy",
  "private": true,
  "version": "2.5.0",
  "description": "1-Click Game Deployment & Reverse Proxy Routing Engine",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "build:win": "vite build && npx electron-builder --win nsis",
    "build:linux": "vite build && npx electron-builder --linux AppImage deb",
    "build:pkg:win": "npm run build && npx @yao-pkg/pkg dist/server.cjs --targets node20-win-x64 --out-path bin/",
    "build:pkg:linux": "npm run build && npx @yao-pkg/pkg dist/server.cjs --targets node20-linux-x64 --out-path bin/",
    "preview": "vite preview",
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true }); try { fs.unlinkSync('server.js'); } catch(e){}\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1122.0",
    "@aws-sdk/s3-request-presigner": "^3.1122.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "dockerode": "^5.0.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gamedig": "^5.3.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "rcon-ts": "^1.2.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
