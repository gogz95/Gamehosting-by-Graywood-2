# ==============================================================================
# GameHost Deployer & Proxy Sentinel Environment Configuration
# ==============================================================================

# Server Port (Defaults to 3000, automatically falls back to 3001/3002 if in use)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=production

# Docker Daemon Endpoint (Leave blank to use default local socket or Windows named pipe)
# Examples:
# Linux Socket: unix:///var/run/docker.sock
# Windows Pipe: //./pipe/docker_engine
# Remote TCP:   tcp://192.168.1.100:2375
DOCKER_HOST=

# Google Gemini API Key (Required for AI crash post-mortem and automated diagnosis)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# S3 / Cloudflare R2 Cloud Backup Vault (Optional)
# Enables automated off-site synchronization of server .tar.gz snapshots
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=gamehost-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Optional default Discord Webhook URL for global cluster alerts
DEFAULT_DISCORD_WEBHOOK_URL=
