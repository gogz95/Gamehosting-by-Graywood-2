# ==============================================================================
# GameHost Deployer & Proxy Sentinel — Environment Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the web panel and API listens on (default: 3000)
PORT=3000

# Run mode: 'development' shows verbose logs; 'production' is required in Docker
NODE_ENV=production

# ── Docker ─────────────────────────────────────────────────────────────────────
# Leave blank to use the default local socket/named pipe.
# Linux:   /var/run/docker.sock  (default, blank)
# Windows: //./pipe/docker_engine (default, blank)
# Remote:  tcp://192.168.1.100:2375
DOCKER_HOST=

# ── AI Crash Diagnosis (Google Gemini) ─────────────────────────────────────────
# Required for the AI crash post-mortem and auto-remediation features.
# Get your key free at: https://aistudio.google.com/
GEMINI_API_KEY=

# ── S3 / Cloudflare R2 Cloud Backup Vault (Optional) ──────────────────────────
# Enables automated off-site sync of server .tar.gz snapshots.
# Cloudflare R2 example endpoint: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_BUCKET=gamehost-backups
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ── Discord Webhook Alerts (Optional) ──────────────────────────────────────────
# Receives cluster-wide events: server crashes, backups, node status changes.
DEFAULT_DISCORD_WEBHOOK_URL=

# ── Worker Agent Node Config ────────────────────────────────────────────────────
# These are used when running docker-compose.agent.yml on a remote Proxmox node.
# Leave blank on the master panel node.

# Full URL of the master panel (http:// or ws:// — agent converts automatically)
MASTER_URL=

# Enrollment token issued from master panel Settings → Nodes
# (maps to NODE_TOKEN env var read by agent.ts)
NODE_TOKEN=

# Human-readable name shown in the cluster node list
NODE_NAME=proxmox-node

# Location label displayed in the cluster UI
NODE_LOCATION=Frankfurt, Germany

# Public IP of this node (optional — leave blank for auto-detection)
NODE_IP=
